# Doxyfile for Fifa26_Simulator

PROJECT_NAME           = "Fifa26_Simulator"
PROJECT_BRIEF          = "Symulator ligi pilkarskiej (core + GUI Qt)"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Polish

INPUT                  = core/headers \
                         gui \
                         mainwindow.h \
                         mainwindow.cpp \
                         main.cpp
FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE                = build \
                         cmake-build-debug \
                         */CMakeFiles/* \
                         */Fifa26_Simulator_autogen/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
INLINE_INHERITED_MEMB  = YES
SORT_MEMBER_DOCS       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO

